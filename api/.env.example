# App
# development: logs legíveis (pino-pretty) | production: logs em JSON
NODE_ENV=development
PORT=3333
APP_NAME="Project News Dashboard API"

# Database (docker compose da raiz expõe o Postgres na porta 5433)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/project_news_db?schema=public"

# Fila (docker compose da raiz expõe o Redis na porta 6380)
REDIS_URL="redis://localhost:6380"

# Logging
LOG_LEVEL=info

# Throttling
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Provedor de IA: gemini 
LLM_PROVIDER=gemini
# Tempo máximo de uma chamada ao provedor de IA, em milissegundos
LLM_TIMEOUT_MS=60000

# Chave do Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Modelo do Gemini; confira no AI Studio os limites do plano gratuito
GEMINI_MODEL=gemini-3.5-flash-lite

# WordPress
# publish: o post vai ao ar direto | draft: fica como rascunho para revisão
WORDPRESS_POST_STATUS=publish