# App
# development: logs legíveis (pino-pretty) | production: logs em JSON
NODE_ENV=development
PORT=3333
APP_NAME="Project News Dashboard API"

# Database (Postgres do docker compose da raiz: porta POSTGRES_PORT, padrão 5433)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/project_news_db?schema=public"

# Fila (Redis do docker compose da raiz: porta REDIS_PORT, padrão 6380)
REDIS_URL="redis://localhost:6380"

# Logging
LOG_LEVEL=info

# Throttling
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Provedor de IA 
LLM_PROVIDER=gemini
# Tempo máximo de uma chamada ao provedor de IA, em milissegundos
LLM_TIMEOUT_MS=60000

# Chave do Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Modelo do Gemini
GEMINI_MODEL=gemini-3.5-flash-lite

# WordPress
# Endereço do WordPress (docker compose da raiz: porta WORDPRESS_PORT, padrão 8080)
WORDPRESS_URL=http://localhost:8080
# Segredo da assinatura HMAC; igual ao WORDPRESS_WEBHOOK_SECRET do docker compose
WORDPRESS_WEBHOOK_SECRET=local-dev-webhook-secret
# Tempo máximo do envio ao WordPress (inclui o download da imagem), em milissegundos
WORDPRESS_TIMEOUT_MS=30000
# publish: o post vai ao ar direto | draft: fica como rascunho para revisão
WORDPRESS_POST_STATUS=publish